[Unit]
Description=Amnezia Control VPN panel
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/amnezia-control
EnvironmentFile=/etc/amnezia-control/panel.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/amnezia-control/.venv/bin/python /opt/amnezia-control/backend/app.py
Restart=on-failure
RestartSec=5
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/amnezia-control /etc/wireguard /etc/amnezia/amneziawg /etc/systemd/system /etc/nginx/sites-available /etc/nginx/sites-enabled

[Install]
WantedBy=multi-user.target
